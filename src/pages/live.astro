---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

/* If the livestream URL is known, set it here */
const streamUrl = "https://youtube.com/live/RyyCch2T7Oo"; // e.g. "https://www.youtube.com/embed/VIDEO_ID"
---

<BaseLayout title="LIVE — BETEL" description="Transmisiuni LIVE de la BETEL" canonical="/live">
  <div class="mx-auto max-w-4xl px-5 py-12">
    <Breadcrumbs items={[{ label: "Acasă", to: "/" }, { label: "LIVE" }]} />

    <header class="mt-6">
      <div class="text-xs font-medium uppercase tracking-[0.2em] text-primary">Live</div>
      <h1 class="mt-2 font-serif text-3xl font-semibold">LIVE</h1>
      <p class="text-muted-foreground mt-2">Urmăriți transmisiunile noastre în direct.</p>
    </header>

    <main aria-label="Transmisiune live">
      {streamUrl
        ? (
          <div class="aspect-video">
            <iframe
              src={streamUrl}
              title="Transmisiune LIVE BETEL"
              frameborder="0"
              allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            />
          </div>
        )
        : (
          <div class="rounded-md border border-border p-6 text-center text-muted-foreground">
            Nu este transmisie live în momentul acesta. Verificați înapoi în timpul slujbelor.
          </div>
        )
      }
    </main>
  </div>
</BaseLayout>
