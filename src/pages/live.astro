---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

const CHANNEL_ID = "UCMN5bRpid3A09cIrkz97H2A";
const CHANNEL_URL = `https://www.youtube.com/channel/${CHANNEL_ID}`;

/*
  Live & upcoming detection strategy (server-side):
  1. Check if channel is currently LIVE (redirect check)
  2. If not live, fetch page and look for latest stream (live or scheduled)
  3. Use YouTube's channel live embed which always shows correct content
*/

interface LiveStatus {
  isLive: boolean;
  isUpcoming: boolean;
  hasContent: boolean;
  videoId?: string;
  startTime?: Date;
}

let liveStatus: LiveStatus = {
  isLive: false,
  isUpcoming: false,
  hasContent: false,
};

try {
  // Step 1: Check for active live via redirect
  console.log(`[Live Detection] Checking ${CHANNEL_ID} for active streams...`);
  
  const redirectRes = await fetch(`https://www.youtube.com/channel/${CHANNEL_ID}/live`, {
    method: "GET",
    redirect: "manual",
    headers: {
      "user-agent":
        "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
    },
  });

  console.log(`[Live Detection] Redirect check status: ${redirectRes.status}`);

  // Check if there's a redirect (means currently live)
  if ((redirectRes.status === 301 || redirectRes.status === 302) && redirectRes.headers) {
    const location = redirectRes.headers.get("location") || "";
    console.log(`[Live Detection] Redirect location: ${location}`);
    
    if (location.includes("/watch?v=")) {
      liveStatus.isLive = true;
      liveStatus.hasContent = true;
      const match = location.match(/v=([A-Za-z0-9_-]{11})/);
      if (match) {
        liveStatus.videoId = match[1];
        console.log(`[Live Detection] ✓ LIVE detected. Video ID: ${liveStatus.videoId}`);
      }
    }
  }

  // Step 2: If not live, fetch page to check for upcoming or get latest stream
  if (!liveStatus.isLive) {
    console.log(`[Live Detection] No live redirect. Fetching page for upcoming/archived streams...`);
    
    try {
      const pageRes = await fetch(`https://www.youtube.com/channel/${CHANNEL_ID}/live`, {
        method: "GET",
        redirect: "follow",
        headers: {
          "user-agent":
            "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
        },
      });

      if (pageRes.ok) {
        const html = await pageRes.text();
        console.log(`[Live Detection] Page fetched. Length: ${html.length} chars`);

        // Extract all video IDs
        const videoMatches = Array.from(html.matchAll(/watch\?v=([A-Za-z0-9_-]{11})/g));
        console.log(`[Live Detection] Found ${videoMatches.length} video references`);

        // Check for upcoming indicators (these are high priority)
        if (/"isUpcoming"\s*:\s*true/.test(html) || /"liveStatus"\s*:\s*"UPCOMING"/.test(html)) {
          console.log(`[Live Detection] ✓ UPCOMING stream detected`);
          liveStatus.isUpcoming = true;
          liveStatus.hasContent = true;

          // Extract the upcoming video ID
          if (videoMatches.length > 0) {
            liveStatus.videoId = videoMatches[0][1];
            console.log(`[Live Detection] Upcoming video ID: ${liveStatus.videoId}`);
          }

          // Try to extract scheduled start time
          let timeMatch = html.match(/"startTimestamp"\s*:\s*"([^"]+)"/);
          if (!timeMatch) timeMatch = html.match(/"scheduledStartTime"\s*:\s*"([^"]+)"/);
          if (!timeMatch) timeMatch = html.match(/"startTime"\s*:\s*(\d{10,})/);

          if (timeMatch && timeMatch[1]) {
            const timeStr = timeMatch[1];
            const parsed = timeStr.match(/^\d{10,}$/)
              ? new Date(parseInt(timeStr, 10) * 1000)
              : new Date(timeStr);

            if (!Number.isNaN(parsed.getTime())) {
              liveStatus.startTime = parsed;
              console.log(`[Live Detection] Start time: ${parsed.toISOString()}`);
            }
          }
        } else if (videoMatches.length > 0) {
          // No upcoming flag, but we found videos - use the first one (latest stream)
          console.log(`[Live Detection] ✓ No upcoming, but found stream content`);
          liveStatus.hasContent = true;
          liveStatus.videoId = videoMatches[0][1];
          console.log(`[Live Detection] Using latest stream video ID: ${liveStatus.videoId}`);
        } else {
          console.log(`[Live Detection] No streams found on channel`);
        }
      } else {
        console.warn(`[Live Detection] Page fetch returned status: ${pageRes.status}`);
      }
    } catch (e) {
      console.warn(`[Live Detection] Failed to fetch channel live page:`, e);
    }
  }
} catch (e) {
  console.warn(`[Live Detection] Detection failed:`, e);
}

console.log(`[Live Detection] Final status:`, {
  isLive: liveStatus.isLive,
  isUpcoming: liveStatus.isUpcoming,
  hasContent: liveStatus.hasContent,
  videoId: liveStatus.videoId,
});

const { isLive, isUpcoming, hasContent } = liveStatus;

// Use channel live URL - YouTube's embed handles routing automatically
const embedUrl = `https://www.youtube.com/embed/live/${CHANNEL_ID}?autoplay=1`;
---

<BaseLayout title="LIVE - BETEL" description="Transmisiuni LIVE de la BETEL" canonical="/live">
  <div class="mx-auto max-w-4xl px-5 py-12">
    <Breadcrumbs items={[{ label: "Acasă", to: "/" }, { label: "LIVE" }]} />

    <header class="mt-6">
      <div class="text-xs font-medium uppercase tracking-[0.2em] text-primary">Live</div>
      <h1 class="mt-2 font-serif text-3xl font-semibold">LIVE</h1>
      <p class="text-muted-foreground mt-2">Urmăriți transmisiunile noastre în direct.</p>
    </header>

    <main class="mt-8">
      {isLive ? (
        <section aria-labelledby="live-heading" class="space-y-4">
          <div class="flex items-center gap-3">
            <span class="inline-flex items-center gap-2 rounded-md bg-red-600 px-2 py-1 text-sm font-semibold text-white">
              <svg
                aria-hidden="true"
                width="10"
                height="10"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="shrink-0 animate-pulse"
              >
                <circle cx="12" cy="12" r="8"></circle>
              </svg>
              Live acum
            </span>
          </div>

          <h2 id="live-heading" class="sr-only">Transmisiune live</h2>

          <div class="w-full overflow-hidden rounded-md bg-black" role="region" aria-label="Transmisiune live video">
            <div style="position:relative;padding-top:56.25%">
              <iframe
                src={embedUrl}
                title="Betel - transmisiune live"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                loading="lazy"
                style="position:absolute;top:0;left:0;width:100%;height:100%;border:0"
              />
            </div>
          </div>

          <p class="text-sm text-muted-foreground">
            Dacă playerul nu pornește automat, încercați <a href={CHANNEL_URL} class="underline">canalul nostru YouTube</a>.
          </p>
        </section>
      ) : isUpcoming ? (
        <section aria-labelledby="upcoming-heading" class="space-y-4">
          <div class="flex items-center gap-3">
            <span class="inline-flex items-center gap-2 rounded-md bg-amber-600 px-2 py-1 text-sm font-semibold text-white">
              <svg
                aria-hidden="true"
                width="10"
                height="10"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="shrink-0"
              >
                <path d="M12 2v10M7 7l3.5 3.5M17 7l-3.5 3.5"></path>
              </svg>
              Programat
            </span>
            <a href={CHANNEL_URL} class="text-sm underline">Vezi pe YouTube</a>
          </div>

          <h2 id="upcoming-heading" class="text-xl font-semibold">Următoarea transmisiune programată</h2>

          <div class="w-full overflow-hidden rounded-md bg-black" role="region" aria-label="Transmisiune programată video">
            <div style="position:relative;padding-top:56.25%">
              <iframe
                src={embedUrl}
                title="Betel - transmisiune programată"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                loading="lazy"
                style="position:absolute;top:0;left:0;width:100%;height:100%;border:0"
              />
            </div>
          </div>

          {liveStatus.startTime ? (
            <p class="text-sm text-muted-foreground">
              Programat pentru: <time datetime={liveStatus.startTime.toISOString()}>
                {liveStatus.startTime.toLocaleString("ro-RO", { dateStyle: "full", timeStyle: "short" })}
              </time>
            </p>
          ) : (
            <p class="text-sm text-muted-foreground">Există o transmisiune programată. Urmăriți canalul pentru detalii.</p>
          )}

          <p class="text-sm text-muted-foreground">
            Dacă playerul nu afișează încă transmisiunea, încercați <a href={CHANNEL_URL} class="underline">canalul nostru YouTube</a>.
          </p>
        </section>
      ) : hasContent ? (
        <section aria-labelledby="archive-heading" class="space-y-4">
          <div class="flex items-center gap-3">
            <span class="inline-flex items-center gap-2 rounded-md bg-blue-600 px-2 py-1 text-sm font-semibold text-white">
              <svg
                aria-hidden="true"
                width="10"
                height="10"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="shrink-0"
              >
                <path d="M9 12l2 2 4-4"></path>
              </svg>
              Arhivă
            </span>
            <a href={CHANNEL_URL} class="text-sm underline">Vezi mai multe pe YouTube</a>
          </div>

          <h2 id="archive-heading" class="text-xl font-semibold">Ultima transmisiune live</h2>

          <div class="w-full overflow-hidden rounded-md bg-black" role="region" aria-label="Transmisiune live din arhivă">
            <div style="position:relative;padding-top:56.25%">
              <iframe
                src={embedUrl}
                title="Betel - transmisiune live din arhivă"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                loading="lazy"
                style="position:absolute;top:0;left:0;width:100%;height:100%;border:0"
              />
            </div>
          </div>

          <p class="text-sm text-muted-foreground">
            Vizionați transmisiunile noastre live din arhivă. Urmăriți <a href={CHANNEL_URL} class="underline">canalul nostru YouTube</a> pentru programări de live.
          </p>
        </section>
      ) : (
        <section aria-labelledby="none-heading" class="space-y-6">
          <h2 id="none-heading" class="text-xl font-semibold">Momentan nu este niciun LIVE</h2>

          <div class="flex flex-col gap-4 md:flex-row md:items-center">
            <div class="flex-1 rounded-md border bg-card p-4">
              <p class="text-muted-foreground">
                În prezent nu avem o transmisiune live activă. Când canalul va transmite în direct sau va programa o transmisiune, playerul va apărea aici automat.
              </p>
              <p class="mt-3 text-sm">
                Urmăriți canalul nostru pentru notificări:
              </p>
              <a
                class="inline-flex items-center gap-2 mt-3 rounded-md bg-primary px-4 py-2 text-sm font-medium text-white hover:opacity-95 focus:outline-none focus:ring-2 focus:ring-primary/50"
                href={CHANNEL_URL}
                rel="noopener noreferrer"
                target="_blank"
              >
                Deschide pe YouTube
              </a>
            </div>

            <aside class="w-full md:w-56">
              <div class="rounded-md border p-3">
                <div class="text-xs font-medium uppercase text-muted-foreground">Urmăriți</div>
                <div class="mt-2 text-sm">
                  Abonați-vă pentru a primi notificări când începem transmisiunea.
                </div>
                <a
                  href={CHANNEL_URL + "/?sub_confirmation=1"}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-3 inline-block w-full rounded-md border px-3 py-2 text-center text-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-primary/50"
                >
                  Abonează-te
                </a>
              </div>
            </aside>
          </div>

          <p class="text-xs text-muted-foreground">
            Detecția LIVE se face la încărcarea paginii. Dacă credeți că e live dar playerul nu apare, încercați reîncărcarea paginii.
          </p>
        </section>
      )}
    </main>
  </div>
</BaseLayout>
