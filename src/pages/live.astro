---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

<BaseLayout title="LIVE — BETEL" description="Transmisiuni LIVE de la BETEL" canonical="/live">
  <div class="mx-auto max-w-4xl px-5 py-12">
    <Breadcrumbs items={[{ label: "Acasă", to: "/" }, { label: "LIVE" }]} />

    <header class="mt-6">
      <div class="text-xs font-medium uppercase tracking-[0.2em] text-primary">Live</div>
      <h1 class="mt-2 font-serif text-3xl font-semibold">LIVE</h1>
      <p class="text-muted-foreground mt-2">Urmăriți transmisiunile noastre în direct. </p>
    </header>

    <div>
    <iframe width="560" height="315" src="www.youtube.com/embed/RyyCch2T7Oo?si=AHu9eSn9xAsvQyVi" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
    </div>

</BaseLayout>
