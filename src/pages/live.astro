---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

const CHANNEL_ID = "UCMN5bRpid3A09cIrkz97H2A";
const CHANNEL_URL = `https://www.youtube.com/channel/${CHANNEL_ID}`;
const API_KEY = "AIzaSyAK2dJTco8GV78YfXpIot5W1Dpu6loH5ho";

interface VideoInfo {
  videoId: string;
  title: string;
  type: "live" | "upcoming" | "completed";
  startTime?: Date;
  scheduledStartTime?: Date;
}

let streamInfo: VideoInfo | null = null;

try {
  console.log(`[YouTube API] ======== START LIVE DETECTION ========`);
  console.log(`[YouTube API] Channel: ${CHANNEL_ID}`);
  console.log(`[YouTube API] Searching for recent videos...`);

  // Search for recent uploads on the channel
  const searchRes = await fetch(
    `https://www.googleapis.com/youtube/v3/search?` +
    `part=snippet&` +
    `channelId=${CHANNEL_ID}&` +
    `type=video&` +
    `order=date&` +
    `maxResults=20&` +
    `key=${API_KEY}`,
    { method: "GET" }
  );

  if (!searchRes.ok) {
    console.error(`[YouTube API] Search failed with status ${searchRes.status}`);
  } else {
    const searchData = await searchRes.json();
    const videos = searchData.items || [];
    console.log(`[YouTube API] Found ${videos.length} recent videos`);

    if (videos.length === 0) {
      console.log(`[YouTube API] No videos found on channel`);
    } else {
      const videoIds = videos.map((item: any) => item.id.videoId).join(",");

      // Get detailed info for all videos
      const videoRes = await fetch(
        `https://www.googleapis.com/youtube/v3/videos?` +
        `part=snippet,liveStreamingDetails&` +
        `id=${videoIds}&` +
        `key=${API_KEY}`,
        { method: "GET" }
      );

      if (!videoRes.ok) {
        console.error(`[YouTube API] Videos details fetch failed with status ${videoRes.status}`);
      } else {
        const videoData = await videoRes.json();
        const allVideos = videoData.items || [];
        console.log(`[YouTube API] Retrieved ${allVideos.length} video details\n`);

        let upcomingFallback: VideoInfo | null = null;
        let completedFallback: VideoInfo | null = null;

        // PASS 1: Look for CURRENTLY LIVE streams
        console.log(`[YouTube API] ═══════════════════════════════════════`);
        console.log(`[YouTube API] PASS 1: HUNTING FOR CURRENTLY LIVE STREAM`);
        console.log(`[YouTube API] ═══════════════════════════════════════`);

        for (let i = 0; i < allVideos.length; i++) {
          const video = allVideos[i];
          const videoId = video.id;
          const title = video.snippet.title;
          const broadcastStatus = video.snippet.liveBroadcastContent;
          const liveDetails = video.liveStreamingDetails || {};
          const actualStartTime = liveDetails.actualStartTime;
          const actualEndTime = liveDetails.actualEndTime;
          const scheduledStartTime = liveDetails.scheduledStartTime;
          const concurrentViewers = liveDetails.concurrentViewers;

          console.log(`\n[YouTube API] [VIDEO ${i}] "${title}"`);
          console.log(`[YouTube API] [VIDEO ${i}] ID: ${videoId}`);
          console.log(`[YouTube API] [VIDEO ${i}] liveBroadcastContent: "${broadcastStatus}"`);
          console.log(`[YouTube API] [VIDEO ${i}] actualStartTime: ${actualStartTime ? `"${actualStartTime}"` : "null"}`);
          console.log(`[YouTube API] [VIDEO ${i}] actualEndTime: ${actualEndTime ? `"${actualEndTime}"` : "null"}`);
          console.log(`[YouTube API] [VIDEO ${i}] scheduledStartTime: ${scheduledStartTime ? `"${scheduledStartTime}"` : "null"}`);
          console.log(`[YouTube API] [VIDEO ${i}] concurrentViewers: ${concurrentViewers ? `"${concurrentViewers}"` : "null"}`);

          // Test each condition
          const cond1 = broadcastStatus === "live";
          const cond2 = !!actualStartTime;
          const cond3 = !actualEndTime;
          const cond4 = !!concurrentViewers;

          console.log(`[YouTube API] [VIDEO ${i}] Condition tests:`);
          console.log(`[YouTube API] [VIDEO ${i}]   ✓ broadcastStatus === "live" ? ${cond1}`);
          console.log(`[YouTube API] [VIDEO ${i}]   ✓ actualStartTime exists ? ${cond2}`);
          console.log(`[YouTube API] [VIDEO ${i}]   ✓ actualEndTime is empty ? ${cond3}`);
          console.log(`[YouTube API] [VIDEO ${i}]   ✓ concurrentViewers exists ? ${cond4}`);

          const isCurrentlyLive = cond1 && cond2 && cond3;
          console.log(`[YouTube API] [VIDEO ${i}]   ► IS CURRENTLY LIVE (cond1 && cond2 && cond3) ? ${isCurrentlyLive}`);

          if (isCurrentlyLive) {
            streamInfo = {
              videoId: videoId,
              title: title,
              type: "live",
            };
            console.log(`[YouTube API] ✓✓✓ MATCH FOUND: Using this LIVE video`);
            break;
          } else {
            console.log(`[YouTube API] [VIDEO ${i}] REJECTED - Not currently live`);
          }
        }

        // PASS 2: If no live found, look for UPCOMING
        if (!streamInfo) {
          console.log(`\n[YouTube API] ═══════════════════════════════════════`);
          console.log(`[YouTube API] PASS 2: HUNTING FOR UPCOMING/SCHEDULED STREAM`);
          console.log(`[YouTube API] ═══════════════════════════════════════`);

          for (let i = 0; i < allVideos.length; i++) {
            const video = allVideos[i];
            const videoId = video.id;
            const title = video.snippet.title;
            const broadcastStatus = video.snippet.liveBroadcastContent;
            const liveDetails = video.liveStreamingDetails || {};
            const scheduledStartTime = liveDetails.scheduledStartTime;
            const actualStartTime = liveDetails.actualStartTime;

            console.log(`\n[YouTube API] [VIDEO ${i}] "${title}"`);
            console.log(`[YouTube API] [VIDEO ${i}] liveBroadcastContent: "${broadcastStatus}"`);
            console.log(`[YouTube API] [VIDEO ${i}] scheduledStartTime: ${scheduledStartTime ? `"${scheduledStartTime}"` : "null"}`);
            console.log(`[YouTube API] [VIDEO ${i}] actualStartTime: ${actualStartTime ? `"${actualStartTime}"` : "null"}`);

            const cond1 = broadcastStatus === "upcoming";
            const cond2 = !!scheduledStartTime;
            const cond3 = !actualStartTime;

            console.log(`[YouTube API] [VIDEO ${i}] Condition tests:`);
            console.log(`[YouTube API] [VIDEO ${i}]   ✓ broadcastStatus === "upcoming" ? ${cond1}`);
            console.log(`[YouTube API] [VIDEO ${i}]   ✓ scheduledStartTime exists ? ${cond2}`);
            console.log(`[YouTube API] [VIDEO ${i}]   ✓ actualStartTime is empty ? ${cond3}`);

            const isUpcoming = cond1 && cond2 && cond3;
            console.log(`[YouTube API] [VIDEO ${i}]   ► IS UPCOMING (cond1 && cond2 && cond3) ? ${isUpcoming}`);

            if (isUpcoming) {
              upcomingFallback = {
                videoId: videoId,
                title: title,
                type: "upcoming",
                scheduledStartTime: new Date(scheduledStartTime),
              };
              console.log(`[YouTube API] ✓ MATCH FOUND: Using this UPCOMING video`);
              break;
            } else {
              console.log(`[YouTube API] [VIDEO ${i}] REJECTED - Not upcoming`);
            }
          }

          if (upcomingFallback) {
            streamInfo = upcomingFallback;
          }
        }

        // PASS 3: If no live or upcoming, use first non-live video as archive
        if (!streamInfo) {
          console.log(`\n[YouTube API] ═══════════════════════════════════════`);
          console.log(`[YouTube API] PASS 3: HUNTING FOR ARCHIVE/COMPLETED STREAM`);
          console.log(`[YouTube API] ═══════════════════════════════════════`);

          for (let i = 0; i < allVideos.length; i++) {
            const video = allVideos[i];
            const videoId = video.id;
            const title = video.snippet.title;
            const broadcastStatus = video.snippet.liveBroadcastContent;
            const publishedAt = video.snippet.publishedAt;

            console.log(`\n[YouTube API] [VIDEO ${i}] "${title}"`);
            console.log(`[YouTube API] [VIDEO ${i}] liveBroadcastContent: "${broadcastStatus}"`);
            console.log(`[YouTube API] [VIDEO ${i}] publishedAt: "${publishedAt}"`);

            const isNotLive = broadcastStatus !== "live";
            console.log(`[YouTube API] [VIDEO ${i}]   ✓ broadcastStatus !== "live" ? ${isNotLive}`);

            if (isNotLive) {
              completedFallback = {
                videoId: videoId,
                title: title,
                type: "completed",
                startTime: new Date(publishedAt),
              };
              console.log(`[YouTube API] ✓ MATCH FOUND: Using this ARCHIVE video`);
              break;
            } else {
              console.log(`[YouTube API] [VIDEO ${i}] REJECTED - Still marked as live`);
            }
          }

          if (completedFallback) {
            streamInfo = completedFallback;
          }
        }
      }
    }
  }
} catch (e) {
  console.error(`[YouTube API] FATAL ERROR:`, e);
}

console.log(`\n[YouTube API] ═══════════════════════════════════════`);
console.log(`[YouTube API] FINAL DECISION`);
console.log(`[YouTube API] ═══════════════════════════════════════`);
console.log(`[YouTube API] Type: ${streamInfo?.type || "NONE"}`);
console.log(`[YouTube API] VideoID: ${streamInfo?.videoId || "NONE"}`);
console.log(`[YouTube API] Title: ${streamInfo?.title || "NONE"}`);
console.log(`[YouTube API] ═══════════════════════════════════════\n`);

const isLive = streamInfo?.type === "live";
const isUpcoming = streamInfo?.type === "upcoming";
const isCompleted = streamInfo?.type === "completed";
const videoId = streamInfo?.videoId || "";
const embedUrl = videoId ? `https://www.youtube.com/embed/${videoId}?autoplay=1` : "";
---

<BaseLayout title="LIVE - BETEL" description="Transmisiuni LIVE de la BETEL" canonical="/live">
  <div class="mx-auto max-w-4xl px-5 py-12">
    <Breadcrumbs items={[{ label: "Acasă", to: "/" }, { label: "LIVE" }]} />

    <header class="mt-6">
      <div class="text-xs font-medium uppercase tracking-[0.2em] text-primary">Live</div>
      <h1 class="mt-2 font-serif text-3xl font-semibold">LIVE</h1>
      <p class="text-muted-foreground mt-2">Urmăriți transmisiunile noastre în direct.</p>
    </header>

    <main class="mt-8">
      {isLive ? (
        <section aria-labelledby="live-heading" class="space-y-4">
          <div class="flex items-center gap-3">
            <span class="inline-flex items-center gap-2 rounded-md bg-red-600 px-2 py-1 text-sm font-semibold text-white">
              <svg
                aria-hidden="true"
                width="10"
                height="10"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="shrink-0 animate-pulse"
              >
                <circle cx="12" cy="12" r="8"></circle>
              </svg>
              Live acum
            </span>
          </div>

          <h2 id="live-heading" class="sr-only">Transmisiune live</h2>

          <div class="w-full overflow-hidden rounded-md bg-black" role="region" aria-label="Transmisiune live video">
            <div style="position:relative;padding-top:56.25%">
              <iframe
                src={embedUrl}
                title={`Betel - ${streamInfo?.title || "transmisiune live"}`}
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                loading="lazy"
                style="position:absolute;top:0;left:0;width:100%;height:100%;border:0"
              />
            </div>
          </div>

          <p class="text-sm text-muted-foreground">
            Dacă playerul nu pornește automat, încercați <a href={CHANNEL_URL} class="underline">canalul nostru YouTube</a>.
          </p>
        </section>
      ) : isUpcoming ? (
        <section aria-labelledby="upcoming-heading" class="space-y-4">
          <div class="flex items-center gap-3">
            <span class="inline-flex items-center gap-2 rounded-md bg-amber-600 px-2 py-1 text-sm font-semibold text-white">
              <svg
                aria-hidden="true"
                width="10"
                height="10"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="shrink-0"
              >
                <path d="M12 2v10M7 7l3.5 3.5M17 7l-3.5 3.5"></path>
              </svg>
              Programat
            </span>
            <a href={CHANNEL_URL} class="text-sm underline">Vezi pe YouTube</a>
          </div>

          <h2 id="upcoming-heading" class="text-xl font-semibold">Următoarea transmisiune programată</h2>

          <div class="w-full overflow-hidden rounded-md bg-black" role="region" aria-label="Transmisiune programată video">
            <div style="position:relative;padding-top:56.25%">
              <iframe
                src={embedUrl}
                title={`Betel - ${streamInfo?.title || "transmisiune programată"}`}
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                loading="lazy"
                style="position:absolute;top:0;left:0;width:100%;height:100%;border:0"
              />
            </div>
          </div>

          {streamInfo?.scheduledStartTime ? (
            <p class="text-sm text-muted-foreground">
              Programat pentru: <time datetime={streamInfo.scheduledStartTime.toISOString()}>
                {streamInfo.scheduledStartTime.toLocaleString("ro-RO", { dateStyle: "full", timeStyle: "short" })}
              </time>
            </p>
          ) : (
            <p class="text-sm text-muted-foreground">Există o transmisiune programată. Urmăriți canalul pentru detalii.</p>
          )}

          <p class="text-sm text-muted-foreground">
            Dacă playerul nu afișează încă transmisiunea, încercați <a href={CHANNEL_URL} class="underline">canalul nostru YouTube</a>.
          </p>
        </section>
      ) : isCompleted ? (
        <section aria-labelledby="archive-heading" class="space-y-4">
          <div class="flex items-center gap-3">
            <span class="inline-flex items-center gap-2 rounded-md bg-blue-600 px-2 py-1 text-sm font-semibold text-white">
              <svg
                aria-hidden="true"
                width="10"
                height="10"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="shrink-0"
              >
                <path d="M9 12l2 2 4-4"></path>
              </svg>
              Arhivă
            </span>
            <a href={CHANNEL_URL} class="text-sm underline">Vezi mai multe pe YouTube</a>
          </div>

          <h2 id="archive-heading" class="text-xl font-semibold">Ultima transmisiune live</h2>

          <div class="w-full overflow-hidden rounded-md bg-black" role="region" aria-label="Transmisiune live din arhivă">
            <div style="position:relative;padding-top:56.25%">
              <iframe
                src={embedUrl}
                title={`Betel - ${streamInfo?.title || "transmisiune live din arhivă"}`}
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                loading="lazy"
                style="position:absolute;top:0;left:0;width:100%;height:100%;border:0"
              />
            </div>
          </div>

          {streamInfo?.startTime ? (
            <p class="text-sm text-muted-foreground">
              Transmisă pe: <time datetime={streamInfo.startTime.toISOString()}>
                {streamInfo.startTime.toLocaleString("ro-RO", { dateStyle: "full", timeStyle: "short" })}
              </time>
            </p>
          ) : (
            <p class="text-sm text-muted-foreground">Vizionați transmisiunile noastre live din arhivă.</p>
          )}

          <p class="text-sm text-muted-foreground">
            Urmăriți <a href={CHANNEL_URL} class="underline">canalul nostru YouTube</a> pentru următoarele programe de live.
          </p>
        </section>
      ) : (
        <section aria-labelledby="none-heading" class="space-y-6">
          <h2 id="none-heading" class="text-xl font-semibold">Momentan nu este niciun LIVE</h2>

          <div class="flex flex-col gap-4 md:flex-row md:items-center">
            <div class="flex-1 rounded-md border bg-card p-4">
              <p class="text-muted-foreground">
                În prezent nu avem o transmisiune live activă sau programată. Când canalul va transmite în direct sau va programa o transmisiune, playerul va apărea aici automat.
              </p>
              <p class="mt-3 text-sm">
                Urmăriți canalul nostru pentru notificări:
              </p>
              <a
                class="inline-flex items-center gap-2 mt-3 rounded-md bg-primary px-4 py-2 text-sm font-medium text-white hover:opacity-95 focus:outline-none focus:ring-2 focus:ring-primary/50"
                href={CHANNEL_URL}
                rel="noopener noreferrer"
                target="_blank"
              >
                Deschide pe YouTube
              </a>
            </div>

            <aside class="w-full md:w-56">
              <div class="rounded-md border p-3">
                <div class="text-xs font-medium uppercase text-muted-foreground">Urmăriți</div>
                <div class="mt-2 text-sm">
                  Abonați-vă pentru a primi notificări când începem transmisiunea.
                </div>
                <a
                  href={CHANNEL_URL + "/?sub_confirmation=1"}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-3 inline-block w-full rounded-md border px-3 py-2 text-center text-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-primary/50"
                >
                  Abonează-te
                </a>
              </div>
            </aside>
          </div>

          <p class="text-xs text-muted-foreground">
            Detecția LIVE se face la încărcarea paginii cu datele din YouTube. Dacă credeți că e live dar playerul nu apare, încercați reîncărcarea paginii.
          </p>
        </section>
      )}
    </main>
  </div>
</BaseLayout>
