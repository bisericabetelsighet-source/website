---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { SITE, authors } from "../lib/blog-data.js";
---

<BaseLayout
  title={`Desore noi - ${SITE.name}`}
  description={`Despre ${SITE.name}: Casa lui Dumnezeu.`}
  canonical="/about"
>
  <div class="mx-auto max-w-3xl px-5 py-12">
    <Breadcrumbs items={[{ label: "Acasă", to: "/" }, { label: "Despre noi" }]} />

    <header class="mt-6">
      <div class="text-xs font-medium uppercase tracking-[0.2em] text-primary">About</div>
      <h1 class="mt-2 font-serif text-5xl font-semibold leading-[1.05]">
        23 de ani de binecuvântări nemăsurate
      </h1>
    </header>

    <div class="prose-article mt-10">
      <p>
        {SITE.name} înseamnă Casa lui Dumnezeu și este cu adevărat țelul acestei clădiri inaugurate în iarna anului 2003. 
      </p>
      <h2 id="history">Scurt Istoric</h2>
      <p>
        Începuturile bisericii noastre nu își au originea pe Popa Lupu nr. 9, ci sunt mult mai vechi...
      </p>
      <h2 id="board">Bordul de Conducere</h2>
      <p>
        Conform Sfintelor Scripturi conducerea bisericilor locale trebuie să fie asigurată de către ...
      </p>
    </div>

    <section class="mt-12 border-t border-border pt-10">
      <h2 class="font-serif text-2xl font-semibold">Comitetul</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          authors.map((author) => (
            <a href={`/authors/${author.slug}`} class="group flex items-start gap-3">
              <img src={author.avatar} alt="" width="48" height="48" class="h-12 w-12 rounded-full" />
              <div>
                <div class="font-serif text-base font-semibold group-hover:text-primary">{author.name}</div>
                <div class="mt-1 text-sm text-muted-foreground">{author.bio}</div>
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
