---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

/* Placeholder video archive items */
const videos = [
  { id: "sermon-2026-07-01", title: "Predică - 1 iulie 2026", thumb: "/thumbnails/sermon1.jpg", link: "https://youtu.be/J84Pma75c6I?si=PAJZbApN5Q0kth94" },
  { id: "sermon-2026-06-24", title: "Predică - 24 iunie 2026", thumb: "/thumbnails/sermon2.jpg", link: "#" }
];
---

<BaseLayout title="Arhiva Video - BETEL" description="Înregistrări video ale slujbelor și evenimentelor noastre" canonical="/archive">
  <div class="mx-auto max-w-6xl px-5 py-12">
    <Breadcrumbs items={[{ label: "Acasă", to: "/" }, { label: "Arhiva Video" }]} />

    <header class="mt-6">
      <div class="text-xs font-medium uppercase tracking-[0.2em] text-primary">Archive</div>
      <h1 class="mt-2 font-serif text-3xl font-semibold">Arhiva Video</h1>
      <p class="text-muted-foreground mt-2">Vizionați înregistrări ale slujbelor, predicilor și evenimentelor.</p>
    </header>

    <main aria-labelledby="video-archive" class="grid gap-6 sm:grid-cols-2">
      {videos.map((v) => (
        <article key={v.id} class="rounded-md overflow-hidden border border-border">
          <a href={v.link} class="block">
            <img src={v.thumb} alt={`Miniatură ${v.title}`} class="w-full object-cover" />
            <div class="p-4">
              <h3 class="text-lg font-medium">{v.title}</h3>
              <div class="mt-3">
                <span class="inline-flex items-center gap-2 text-sm text-muted-foreground">
                  <Icon name="play" class="h-4 w-4" /> Vizionați
                </span>
              </div>
            </div>
          </a>
        </article>
      ))}
    </main>
  </div>
</BaseLayout>
