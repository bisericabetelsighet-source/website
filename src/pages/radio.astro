---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

/* Example radio shows — replace with real sources or audio files */
const shows = [
  { id: "morning-prayer", title: "Simion Bumbar", src: "/media/radio/indexpredica.mp3" },
  { id: "devotional", title: "Alex Palas", src: "/media/radio/indexpredica.mp3" }
];
---

<BaseLayout title="Radio - BETEL" description="Serii de predici susținute în cadrul bisericii noastre" canonical="/radio">
  <div class="mx-auto max-w-4xl px-5 py-12">
    <Breadcrumbs items={[{ label: "Acasă", to: "/" }, { label: "Radio" }]} />

    <header class="mt-6">
      <div class="text-xs font-medium uppercase tracking-[0.2em] text-primary">Radio</div>
      <h1 class="mt-2 font-serif text-3xl font-semibold">Radio</h1>
      <p class="text-muted-foreground mt-2">Ascultă seriile de predici ținute în biserica noastră.</p>
    </header>

    <main aria-label="Emisiuni">
      <ul class="space-y-6">
        {shows.map((s) => (
          <li key={s.id} class="rounded-md border border-border p-5">
            <div class="flex items-center justify-between gap-4">
              <div>
                <h2 class="text-lg font-medium">{s.title}</h2>
                <p class="text-sm text-muted-foreground mt-1"> Index - Titlu predica - Seria de predici de care apartine .</p>
              </div>
              <div>
                <audio controls preload="none" aria-label={`Ascultă ${s.title}`}>
                  <source src={s.src} />
                  Browserul tău nu suportă elementul audio.
                </audio>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </main>
  </div>
</BaseLayout>
