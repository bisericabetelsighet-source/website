---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

/* Example events list — replace with dynamic content as needed */
const events = [
  {
    id: "sunday-service",
    title: "Rugăciune și Vestirea Evangheliei - Duminică",
    date: "2026-08-16T12:00:00+03:00, T20:00:00+03:00",
    location: "Biserica BETEL, Str. Popa Lupu nr. 9",
    excerpt: "Vă așteptăm alături de noi în fiecare zi de duminică de la ora 9 și ora 17.",
    link: "#"
  }/*,
  {
    id: "youth-meeting",
    title: "Întâlnire tineret",
    date: "2026-08-12T18:30:00+03:00",
    location: "Biserica BETEL, Str. Popa Lupu nr. 9",
    excerpt: "-DESCRIPTION-",
    link: "#"
  }*/
];
---

<BaseLayout title="Evenimente — BETEL" description="Calendarul evenimentelor și slujbelor BETEL" canonical="/events">
  <div class="mx-auto max-w-5xl px-5 py-12">
    <Breadcrumbs items={[{ label: "Acasă", to: "/" }, { label: "Evenimente" }]} />

    <header class="mt-6">
      <div class="text-xs font-medium uppercase tracking-[0.2em] text-primary">Events</div>
      <h1 class="mt-2 font-serif text-3xl font-semibold">Evenimente</h1>
      <p class="text-muted-foreground mt-2">Următoarele întâlniri, slujbe și evenimente organizate de comunitatea noastră.</p>
    </header>

    <main aria-labelledby="upcoming-events">
      <h2 id="upcoming-events" class="sr-only">Evenimente viitoare</h2>
      <ul class="space-y-6">
        {events.map((ev) => (
          <li key={ev.id} class="rounded-md border border-border p-5">
            <article>
              <div class="flex items-start justify-between gap-4">
                <div>
                  <h3 class="text-xl font-semibold"><a href={ev.link} class="hover:underline">{ev.title}</a></h3>
                  <p class="text-sm text-muted-foreground mt-1">{ev.excerpt}</p>
                  <p class="mt-3 text-sm">
                    <time datetime={ev.date} class="font-medium">{new Date(ev.date).toLocaleString("ro-RO", { dateStyle: "long", timeStyle: "short" })}</time>
                    <span class="mx-2">•</span>
                    <span>{ev.location}</span>
                  </p>
                </div>
                <div class="flex-shrink-0">
                  <a href={ev.link} class="inline-flex items-center gap-2 rounded-md border px-3 py-2 text-sm hover:bg-muted">
                    Detalii
                    <Icon name="arrow-right" class="h-4 w-4" />
                  </a>
                </div>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </main>
  </div>
</BaseLayout>
