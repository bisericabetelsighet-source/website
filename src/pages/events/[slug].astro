---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Icon from "../components/Icon.astro";
import { events } from "../lib/events-data.js";
---

<BaseLayout title="Evenimente - BETEL" description="Calendarul evenimentelor și slujbelor BETEL" canonical="/events">
  <div class="mx-auto max-w-5xl px-5 py-12">
    <Breadcrumbs items={[{ label: "Acasă", to: "/" }, { label: "Evenimente" }]} />

    <header class="mt-6">
      <div class="text-xs font-medium uppercase tracking-[0.2em] text-primary">Events</div>
      <h1 class="mt-2 font-serif text-3xl font-semibold">Evenimente</h1>
      <p class="text-muted-foreground mt-2">Următoarele întâlniri, slujbe și evenimente organizate de comunitatea noastră.</p>
    </header>

    <main aria-labelledby="upcoming-events">
      <h2 id="upcoming-events" class="sr-only">Evenimente viitoare</h2>
      <ul class="space-y-6">
        {events.map((event) => (
          <li key={event.slug} class="rounded-md border border-border p-5">
            <article>
              <div class="flex items-start justify-between gap-4">
                <div>
                  <h3 class="text-xl font-semibold">
                    <a href={`/events/${event.slug}`} class="hover:underline">{event.title}</a>
                  </h3>
                  <p class="mt-1 text-sm text-muted-foreground">{event.excerpt}</p>
                  <p class="mt-3 text-sm">
                    <time datetime={event.date} class="font-medium">{new Date(event.date).toLocaleString("ro-RO", { dateStyle: "long", timeStyle: "short" })}</time>
                    <span class="mx-2">•</span>
                    <span>{event.location}</span>
                  </p>
                </div>
                <div class="flex-shrink-0">
                  <a href={`/events/${event.slug}`} class="inline-flex items-center gap-2 rounded-md border px-3 py-2 text-sm hover:bg-muted">
                    Detalii
                    <Icon name="arrow-right" class="h-4 w-4" />
                  </a>
                </div>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </main>
  </div>
</BaseLayout>
